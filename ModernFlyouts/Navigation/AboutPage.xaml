<Page x:Class="ModernFlyouts.Navigation.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ModernFlyouts" xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:ModernFlyouts.Controls"
      xmlns:utils="clr-namespace:ModernFlyouts.Utilities"
      xmlns:resx="clr-namespace:ModernFlyouts.Properties"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800">
    <controls:ScrollViewerEx>
        <ui:SimpleStackPanel Spacing="10" Margin="20">
            <TextBlock FontWeight="SemiBold" Style="{DynamicResource TitleTextBlockStyle}"
                       Text="{x:Static local:Program.AppName}" />
            <Image Source="/Assets/Images/ModernFlyouts_128.png" HorizontalAlignment="Left" Height="128" />
            <TextBlock TextWrapping="Wrap" Text="{x:Static resx:Strings.About_AppDescription}" />
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                <Run FontWeight="SemiBold" Text="Fork disclosure: " />
                <Run Text="GlobalFlyouts is a fork by Astear17 of ModernFlyouts, based on the upstream 0.9.3 release tag." />
            </TextBlock>
            <TextBlock TextWrapping="Wrap"
                       Text="This fork preserves the original ModernFlyouts UI and modules while adding an enhanced media backend, session priority policy, artwork caching, timeline/progress handling, and fallback app identity resolution." />
            <TextBlock>
                <Run Text="{x:Static resx:Strings.About_Version}" />
                <Bold>
                    <Run Text="{x:Static local:Program.AppVersion}" />
                </Bold>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"
                       Text="Project links" />
            <ui:HyperlinkButton Content="GlobalFlyouts repository"
                                NavigateUri="https://github.com/Astear17/GlobalFlyouts" />
            <ui:HyperlinkButton Content="Report an issue"
                                NavigateUri="https://github.com/Astear17/GlobalFlyouts/issues/new/choose" />
            <ui:HyperlinkButton Content="Original ModernFlyouts project"
                                NavigateUri="https://github.com/ModernFlyouts-Community/ModernFlyouts" />
        </ui:SimpleStackPanel>
    </controls:ScrollViewerEx>
</Page>
